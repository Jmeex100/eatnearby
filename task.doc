-- Table: community_restaurant
CREATE TABLE IF NOT EXISTS `community_restaurant` (
    `id` BIGINT NOT NULL AUTO_INCREMENT,
    `created_at` DATETIME NOT NULL,
    `updated_at` DATETIME NOT NULL,
    `name` VARCHAR(255) NOT NULL,
    `email` VARCHAR(254),
    `phone` VARCHAR(20) NOT NULL,
    `address` VARCHAR(255) NOT NULL,
    `city` VARCHAR(100) NOT NULL,
    `description` TEXT NOT NULL,
    `website` VARCHAR(200),
    `is_verified` TINYINT(1) NOT NULL,
    `country` VARCHAR(100) NOT NULL,
    `profile_image` VARCHAR(100),
    PRIMARY KEY (`id`),
    INDEX `community_r_name_ff4ff3_idx` (`name`),
    INDEX `community_r_city_059990_idx` (`city`, `country`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- Table: community_recipetag
CREATE TABLE IF NOT EXISTS `community_recipetag` (
    `id` BIGINT NOT NULL AUTO_INCREMENT,
    `created_at` DATETIME NOT NULL,
    `updated_at` DATETIME NOT NULL,
    `name` VARCHAR(50) NOT NULL,
    `slug` VARCHAR(50) NOT NULL,
    PRIMARY KEY (`id`),
    UNIQUE KEY `name` (`name`),
    UNIQUE KEY `slug` (`slug`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- Table: community_challenge
CREATE TABLE IF NOT EXISTS `community_challenge` (
    `id` BIGINT NOT NULL AUTO_INCREMENT,
    `created_at` DATETIME NOT NULL,
    `updated_at` DATETIME NOT NULL,
    `title` VARCHAR(150) NOT NULL,
    `slug` VARCHAR(150) NOT NULL,
    `description` TEXT NOT NULL,
    `banner_image` VARCHAR(100),
    `start_date` DATE NOT NULL,
    `end_date` DATE NOT NULL,
    `is_active` TINYINT(1) NOT NULL,
    PRIMARY KEY (`id`),
    UNIQUE KEY `slug` (`slug`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- Table: community_post
CREATE TABLE IF NOT EXISTS `community_post` (
    `id` BIGINT NOT NULL AUTO_INCREMENT,
    `created_at` DATETIME NOT NULL,
    `updated_at` DATETIME NOT NULL,
    `title` VARCHAR(200) NOT NULL,
    `content` TEXT NOT NULL,
    `is_published` TINYINT(1) NOT NULL,
    `post_type` VARCHAR(10) NOT NULL,
    `image` VARCHAR(100),
    `author_id` BIGINT NOT NULL,
