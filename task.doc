-- Table: cart_cartitem
CREATE TABLE IF NOT EXISTS `cart_cartitem` (
    `id` BIGINT NOT NULL AUTO_INCREMENT,
    `quantity` INTEGER UNSIGNED NOT NULL,
    `quality` VARCHAR(20) NOT NULL,
    `cart_id` BIGINT NOT NULL,
    `drink_id` VARCHAR(100),
    `fast_food_id` VARCHAR(100),
    `food_id` VARCHAR(100),
    PRIMARY KEY (`id`),
    INDEX `cart_cartitem_cart_id_370ad265` (`cart_id`),
    INDEX `cart_cartitem_drink_id_d6a39484` (`drink_id`),
    INDEX `cart_cartitem_fast_food_id_f229cdc1` (`fast_food_id`),
    INDEX `cart_cartitem_food_id_7bb68841` (`food_id`),
    CONSTRAINT `fk_cart_cartitem_cart_id` FOREIGN KEY (`cart_id`) 
        REFERENCES `cart_cart` (`id`) ON DELETE CASCADE,
    CONSTRAINT `fk_cart_cartitem_drink_id` FOREIGN KEY (`drink_id`) 
        REFERENCES `auths_drink` (`product_id`) ON DELETE SET NULL,
    CONSTRAINT `fk_cart_cartitem_fast_food_id` FOREIGN KEY (`fast_food_id`) 
        REFERENCES `auths_fastfood` (`product_id`) ON DELETE SET NULL,
    CONSTRAINT `fk_cart_cartitem_food_id` FOREIGN KEY (`food_id`) 
        REFERENCES `auths_food` (`product_id`) ON DELETE SET NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- Table: payments_deliveryinfo
CREATE TABLE IF NOT EXISTS `payments_deliveryinfo` (
    `id` BIGINT NOT NULL AUTO_INCREMENT,
    `address` VARCHAR(100),
    `predefined_address` VARCHAR(30),
    `delivery_status` VARCHAR(20) NOT NULL,
    `payment_method` VARCHAR(20) NOT NULL,
    `phone_number` VARCHAR(20) NOT NULL,
    `secondary_phone_number` VARCHAR(20),
    `created_at` DATETIME NOT NULL,
    `updated_at` DATETIME NOT NULL,
    `cart_id` BIGINT NOT NULL,
    `user_id` BIGINT NOT NULL,
    `payment_provider` VARCHAR(20),
    `is_pos_order` TINYINT(1) NOT NULL,
    `driver_location` TEXT,
    `last_location_update` DATETIME,
    `restaurant_location` TEXT,
    PRIMARY KEY (`id`),
    INDEX `payments_deliveryinfo_cart_id_5ca53b70` (`cart_id`),
    INDEX `payments_deliveryinfo_user_id_4d164558` (`user_id`),
    CONSTRAINT `fk_payments_deliveryinfo_cart_id` FOREIGN KEY (`cart_id`) 
        REFERENCES `cart_cart` (`id`) ON DELETE CASCADE,
    CONSTRAINT `fk_payments_deliveryinfo_user_id` FOREIGN KEY (`user_id`) 
        REFERENCES `auths_user` (`id`) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- Table: payments_paymenthistory
CREATE TABLE IF NOT EXISTS `payments_paymenthistory` (
    `id` BIGINT NOT NULL AUTO_INCREMENT,
    `total` DECIMAL(10,2) NOT NULL,
    `created_at` DATETIME NOT NULL,
    `cart_id` BIGINT,
    `delivery_info_id` BIGINT,
