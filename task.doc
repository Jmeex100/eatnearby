    `updated_at` DATETIME NOT NULL,
    `user_id` BIGINT NOT NULL,
    PRIMARY KEY (`id`),
    INDEX `cart_cart_user_id_9b4220b9` (`user_id`),
    CONSTRAINT `fk_cart_cart_user_id` FOREIGN KEY (`user_id`) 
        REFERENCES `auths_user` (`id`) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

-- Table: auths_drink
CREATE TABLE IF NOT EXISTS `auths_drink` (
    `product_id` VARCHAR(100) NOT NULL,
