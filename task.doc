-- Table: staffs_notification
CREATE TABLE IF NOT EXISTS `staffs_notification` (
    `id` BIGINT NOT NULL AUTO_INCREMENT,
    `message` TEXT NOT NULL,
    `is_read` TINYINT(1) NOT NULL,
    `created_at` DATETIME NOT NULL,
    `recipient_id` BIGINT NOT NULL,
    `related_delivery_id` BIGINT,
    `notification_type` VARCHAR(30) NOT NULL,
    PRIMARY KEY (`id`),
    INDEX `staffs_notification_recipient_id_722904b5` (`recipient_id`),
    INDEX `staffs_notification_related_delivery_id_7f56dc41` (`related_delivery_id`),
    CONSTRAINT `fk_staffs_notification_recipient_id` FOREIGN KEY (`recipient_id`) 
        REFERENCES `auths_user` (`id`) ON DELETE CASCADE,
    CONSTRAINT `fk_staffs_notification_related_delivery_id` FOREIGN KEY (`related_delivery_id`) 
        REFERENCES `payments_deliveryinfo` (`id`) ON DELETE SET NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

