    `transaction_id` VARCHAR(100),
    `items` TEXT NOT NULL,
    PRIMARY KEY (`id`),
    INDEX `payments_paymenthistory_cart_id_fcf8ed0e` (`cart_id`),
    INDEX `payments_paymenthistory_delivery_info_id_ee728190` (`delivery_info_id`),
    INDEX `payments_paymenthistory_user_id_f963c89b` (`user_id`),
    CONSTRAINT `fk_payments_paymenthistory_cart_id` FOREIGN KEY (`cart_id`) 
        REFERENCES `cart_cart` (`id`) ON DELETE SET NULL,
    CONSTRAINT `fk_payments_paymenthistory_delivery_info_id` FOREIGN KEY (`delivery_info_id`) 
        REFERENCES `payments_deliveryinfo` (`id`) ON DELETE SET NULL,
    CONSTRAINT `fk_payments_paymenthistory_user_id` FOREIGN KEY (`user_id`) 
        REFERENCES `auths_user` (`id`) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

